{
  "name": "socc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @socc/api dev",
    "worker": "pnpm --filter @socc/api worker",
    "build": "pnpm --filter @socc/api build",
    "start": "pnpm --filter @socc/api start",
    "start:worker": "pnpm --filter @socc/api worker:start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml}\"",
    "typecheck": "pnpm --filter @socc/api typecheck",
    "test:unit": "pnpm --filter @socc/api test:unit",
    "test:integration": "pnpm --filter @socc/api test:integration",
    "test": "pnpm --filter @socc/api test",
    "db:up": "docker compose -p socc --env-file apps/api/.env up -d --wait postgres",
    "redis:up": "docker compose -p socc --env-file apps/api/.env up -d --wait redis",
    "infra:up": "docker compose -p socc --env-file apps/api/.env up -d --wait postgres redis",
    "db:down": "docker compose -p socc --env-file apps/api/.env down",
    "db:migrate": "pnpm --filter @socc/api db:migrate",
    "db:seed": "pnpm --filter @socc/api db:seed",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
