# SOCC local development environment — PLACEHOLDER VALUES ONLY.
# Copy to `apps/api/.env` and adjust for your machine. Never commit `.env`.
# The Prisma CLI, NestJS API, tests, and docker compose (via --env-file)
# all read this single file.

# --- Docker Compose (SOCC-owned PostgreSQL on host port 5433) ---
SOC_POSTGRES_PORT=5433
SOC_POSTGRES_PASSWORD=socc_owner_dev_password
SOC_APP_DB_PASSWORD=socc_app_dev_password

# Used by the NestJS API at runtime (least-privilege role; RLS enforced).
SOC_APP_DATABASE_URL=postgresql://socc_app:socc_app_dev_password@localhost:5433/socc

# Used by the Prisma CLI (migrations/seed) and by `prisma migrate` only.
# The API never connects with this URL.
DATABASE_URL=postgresql://socc_owner:socc_owner_dev_password@localhost:5433/socc

# --- API ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Sessions ---
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

# --- CORS / CSRF origin checks (comma-separated absolute origins) ---
ALLOWED_ORIGINS=http://localhost:3001
