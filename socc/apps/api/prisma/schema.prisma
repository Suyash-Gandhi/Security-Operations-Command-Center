generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum AssetStatus {
  ACTIVE
  INACTIVE
}

enum EventSourceStatus {
  ACTIVE
  DISABLED
}

enum EventBatchStatus {
  ACCEPTED
  COMPLETED
  REJECTED
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  status             OrganizationStatus @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  memberships        OrganizationMembership[]
  auditLogs          AuditLog[]
  assets             Asset[]
  eventSources       EventSource[]
  eventBatches       EventBatch[]
  securityEvents     SecurityEvent[]
  outboxMessages     OutboxMessage[]
  idempotencyRecords IdempotencyRecord[]
  detectionRules     DetectionRule[]
  detectionMatches   DetectionMatch[]
  alerts             Alert[]

  @@index([status])
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  normalizedEmail String  @unique
  displayName    String
  status         UserStatus @default(ACTIVE)
  passwordHash   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  memberships    OrganizationMembership[]
  sessions       Session[]
  auditLogs      AuditLog[]
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  description     String
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String     @db.Uuid
  roleId       String     @db.Uuid
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([membershipId, roleId])
}

model Session {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  tokenHash  String        @unique
  status     SessionStatus @default(ACTIVE)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())
  lastSeenAt DateTime      @default(now())
  userAgent  String?
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorId        String?       @db.Uuid
  action         String
  resourceType   String
  resourceId     String?       @db.Uuid
  requestId      String?
  metadata       Json?
  occurredAt     DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([actorId])
}

model Asset {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String
  assetType      String
  hostname       String?
  environment    String?
  criticality    String?
  owner          String?
  status         AssetStatus     @default(ACTIVE)
  lastSeenAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events         SecurityEvent[]

  @@index([organizationId, status])
  @@index([organizationId, hostname])
  @@index([organizationId, name])
}

model EventSource {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  name           String
  sourceType     String
  credentialHash String            @unique
  status         EventSourceStatus @default(ACTIVE)
  lastEventAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches        EventBatch[]
  events         SecurityEvent[]

  @@index([organizationId, status])
}

model EventBatch {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  sourceId       String           @db.Uuid
  status         EventBatchStatus @default(ACCEPTED)
  acceptedCount  Int              @default(0)
  rejectedCount  Int              @default(0)
  processedCount Int              @default(0)
  errorSummary   String?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         EventSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  events         SecurityEvent[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([sourceId])
}

model SecurityEvent {
  id                   String           @id @default(uuid()) @db.Uuid
  batchId              String           @db.Uuid
  organizationId       String           @db.Uuid
  sourceId             String           @db.Uuid
  assetId              String?          @db.Uuid
  sourceEventId        String?
  dedupeKey            String
  schemaVersion        Int              @default(1)
  eventType            String
  eventTime            DateTime
  receivedAt           DateTime         @default(now())
  severity             String?
  actor                String?
  sourceIp             String?
  normalizedPayload    Json
  rawPayloadReference  String?
  processedAt          DateTime?
  createdAt            DateTime         @default(now())
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source               EventSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  batch                EventBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  asset                Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  detectionMatches     DetectionMatch[]
  alertEvents          AlertEvent[]

  @@unique([organizationId, sourceId, dedupeKey])
  @@index([organizationId, eventTime(sort: Desc), id])
  @@index([organizationId, eventType, eventTime(sort: Desc)])
  @@index([organizationId, sourceId, eventTime(sort: Desc)])
  @@index([assetId])
}

model OutboxMessage {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  aggregateType  String
  aggregateId    String       @db.Uuid
  messageType    String
  schemaVersion  Int          @default(1)
  payload        Json
  createdAt      DateTime     @default(now())
  publishedAt    DateTime?
  attemptCount   Int          @default(0)
  lastError      String?
  nextAttemptAt  DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, publishedAt, createdAt])
  @@index([publishedAt, nextAttemptAt])
}

model IdempotencyRecord {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  idempotencyKey    String
  requestHash       String
  resourceReference String       @db.Uuid
  createdAt         DateTime     @default(now())
  expiresAt         DateTime
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, expiresAt])
}

enum DetectionRuleType {
  THRESHOLD
  SEQUENCE
}

enum DetectionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

model DetectionRule {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @db.Uuid
  name           String
  description    String
  ruleType       DetectionRuleType
  configuration  Json
  severity       DetectionSeverity
  enabled        Boolean          @default(true)
  version        Int              @default(1)
  createdBy      String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matches        DetectionMatch[]
  alerts         Alert[]

  @@index([organizationId, enabled])
  @@index([enabled])
}

model DetectionMatch {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  ruleId         String        @db.Uuid
  ruleVersion    Int
  matchKey       String
  eventId        String        @db.Uuid
  matchedAt      DateTime      @default(now())
  evidence       Json
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule           DetectionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  event          SecurityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([organizationId, ruleId, matchKey])
  @@index([organizationId, matchedAt(sort: Desc)])
  @@index([ruleId])
  @@index([eventId])
}

model Alert {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  ruleId         String        @db.Uuid
  ruleVersion    Int
  severity       DetectionSeverity
  status         AlertStatus   @default(OPEN)
  title          String
  description    String
  matchKey       String
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  count          Int           @default(1)
  assetId        String?       @db.Uuid
  primaryEventId String?      @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule           DetectionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  events         AlertEvent[]

  @@unique([organizationId, ruleId, matchKey])
  @@index([organizationId, status, severity, lastSeenAt(sort: Desc)])
}

model AlertEvent {
  alertId   String        @db.Uuid
  eventId   String        @db.Uuid
  createdAt DateTime      @default(now())
  alert     Alert         @relation(fields: [alertId], references: [id], onDelete: Cascade)
  event     SecurityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([alertId, eventId])
}
